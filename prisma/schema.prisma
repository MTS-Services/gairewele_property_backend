generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================
enum Role {
  USER
  ADMIN
  AGENT
  DEVELOPER
  OWNER
}

enum AuthProvider {
  LOCAL
  FIREBASE
}

enum PropertyRequestStatus {
  NEW
  IN_PROCESS
  COMPLETED
}

enum PropertyType {
  APARTMENT
  HOUSE
  VILLA
  PENTHOUSE
  STUDIO
  TOWNHOUSE
  DETACHED
  SEMI_DETACHED
  TERRACE
  FLAT
  OFFICE_SPACE
  OTHERS
}

enum PropertyCondition {
  NEW
  RENOVATED
  FAIRLY_USED
  UNDER_CONSTRUCTION
  OFF_PLAN
}

enum PropertyListingType {
  FOR_SALE
  FOR_RENT
  FOR_LEASE
  OTHERS
}

enum PropertyApprovalStatus {
  PENDING
  PUBLISHED
  REJECTED
  FEATURED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
  PURPLE
}

enum AdPlacement {
  HOMEPAGE
  BLOG
  PROPERTIES
  REGISTER
}

enum AdStatus {
  SPONSOR
  FEATURED
  STANDARD
}

enum BlogCategory {
  BUY
  RENT
  INVEST
  MARKET_NEWS
  GUIDES
  DESIGN_LIFESTYLE
  LEGAL
  COMMERCIAL
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model User {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique
  password        String?
  image           String?
  role            Role          @default(USER)
  provider        AuthProvider  @default(LOCAL)
  firebaseUid     String?       @unique

  // Professional fields (Agent / Developer / Owner)
  phoneNumber     String?
  whatsappNumber  String?
  companyName     String?
  website         String?
  companyLogo     String?

  isActive        Boolean       @default(true)
  isSuspended     Boolean       @default(false)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  properties        Property[]          @relation("PropertyOwner")
  propertyRequests  PropertyRequest[]
  subscription      Subscription?
  blogs             Blog[]              @relation("BlogAuthor")
  ads               Advertisement[]     @relation("AdCreator")
  sentMessages      Message[]           @relation("MessageSender")
  receivedMessages  Message[]           @relation("MessageReceiver")
  conversationParticipants ConversationParticipant[]
  refreshTokens     RefreshToken[]
  savedListings     SavedListing[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}


model PropertyRequest {
  id                  String                @id @default(uuid())
  propertyType        PropertyType
  preferredLocation   String
  bedrooms            Int
  bathrooms           Int
  budgetMin           Decimal               @db.Decimal(15, 2)
  budgetMax           Decimal               @db.Decimal(15, 2)
  areaMin             Int
  areaMax             Int
  preferredMoveInDate DateTime?
  fullName            String
  email               String
  phoneNumber         String
  preferences         String?

  status              PropertyRequestStatus @default(NEW)

  userId              String?
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}


model Property {
  id              String                 @id @default(uuid())
  title           String
  description     String
  propertyType    PropertyType
  condition       PropertyCondition
  size            String
  propertyTitle   String
  listingType     PropertyListingType

  location        String
  propertyAddress String

  images          PropertyImage[]
  videoUrl        String?

  askingPrice     Decimal                @db.Decimal(15, 2)
  whatsappNumber  String?

  companyName     String?
  officeAddress   String?
  phoneNumber     String?

  approvalStatus  PropertyApprovalStatus @default(PENDING)

  ownerId         String
  owner           User                   @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  savedBy         SavedListing[]

  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model SavedListing {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

model PropertyImage {
  id          String   @id @default(uuid())
  url         String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([propertyId])
}


model Subscription {
  id        String           @id @default(uuid())
  userId    String           @unique
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan @default(FREE)
  startDate DateTime         @default(now())
  endDate   DateTime?
  isActive  Boolean          @default(true)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}


model Advertisement {
  id          String      @id @default(uuid())
  image       String
  liveLink    String
  title       String
  description String?
  placement   AdPlacement
  status      AdStatus    @default(STANDARD)
  startDate   DateTime
  endDate     DateTime

  impressions Int         @default(0)
  clicks      Int         @default(0)
  isPaused    Boolean     @default(false)

  createdById String?
  createdBy   User?       @relation("AdCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}


model Blog {
  id              String       @id @default(uuid())
  images          String[]
  title           String
  subtitle        String?
  content         String
  metaDescription String?
  urlSlug         String       @unique
  category        BlogCategory
  tags            String[]

  authorId        String?
  author          User?        @relation("BlogAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName      String?

  pdfTitle        String?
  pdfFileUrl      String?
  publishDate     DateTime?
  excerpt         String?

  status          BlogStatus   @default(DRAFT)
  views           Int          @default(0)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}


model Conversation {
  id           String                    @id @default(uuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  receiverId     String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  content        String?
  mediaUrl       String?
  mediaType      String?      // "image" | "video" | "file"
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
